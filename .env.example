# Server-side environment variables — Netlify Functions only.
# The client bundle ships NO secrets: never add any VITE_-prefixed value here.
# Set the real values in the Netlify project settings (see README).

# SHA-256 hash of the access password. The /api/login function hashes the
# submitted password and compares it against this (constant-time).
APP_PASSWORD_HASH=your_sha256_password_hash_here

# Neon Postgres connection string, used by the sync Netlify Functions.
NEON_DATABASE_URL=postgresql://user:password@host/dbname

# Optional. Unset (the default) = talk to Neon directly. Set it only when
# self-hosting against plain Postgres behind a Neon-compatible HTTP proxy: the
# full URL of the proxy's SQL endpoint, path included. Read by the functions
# and by the scripts in scripts/ that write to the database.
# NEON_HTTP_ENDPOINT=http://neon-proxy:4444/sql

# Independent random sync credential — OUR OWN, not Neon's. It guards our own
# endpoints (the six sync-* functions and the coach edge function), and you
# invent its value: it is not issued by any provider and rotating it is not a
# Neon console operation. It was called NEON_API_KEY until 2026-08-15, which
# read as a Neon account credential and inflated its apparent blast radius.
# /api/login returns it to the client only after a correct password; the client
# then sends it as the Bearer token. Rotate it independently of the password
# whenever needed — every device then has to unlock once more.
SYNC_API_KEY=your_random_sync_secret_here

# LLM coach (server-side only — never in the client bundle)
# The coach walks a ladder of models across two vendors
# (netlify/functions/lib/providers.js): Claude Sonnet 5.5, then Claude Opus 5.5,
# then two Mistral models.
#
# Anthropic is the first vendor. The coach handles
# personal health data, and it goes to a US company (inference_geo global,
# no training on API data) for the quality of the coaching. CREATE THE KEY FROM
# INSIDE A WORKSPACE: an org-level key is a 400 on every request, both Claude
# rungs fail at once, and the coach quietly answers on Mistral instead.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Mistral holds the coach through an Anthropic outage (Paris, GDPR baseline,
# outside the US CLOUD Act, no training on API data). Its rate limits are
# ACCOUNT-level, so its two rungs survive one model being overloaded, not a quota.
#
# Groq and OpenRouter stay rejected: Groq's free tier could not fit a coach
# request (removed 2026-08-01), and OpenRouter's free models are logged and
# routed to arbitrary third parties.
MISTRAL_API_KEY=your-mistral-api-key

# Optional, server.mjs only (ignored on Netlify). The login throttle counts wrong
# guesses per client address, which server.mjs takes from the connection itself.
# Behind a reverse proxy every connection comes from the proxy, so NAME it here:
# its address(es), as IPs or CIDRs separated by commas. When a request comes from
# one of them, the address becomes the LAST (rightmost) X-Forwarded-For entry —
# the one the proxy appended; entries to its left come from the client. Requests
# from anyone else keep their own address, whatever header they send.
# - nginx: add  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
# - Caddy: reverse_proxy sets X-Forwarded-For by default.
# WARNING: the proxy must APPEND the address it sees. A proxy that passes the
# client's own X-Forwarded-For through unchanged — nginx WITHOUT the line above
# does exactly that — lets every client pick its own throttle bucket.
# - Proxy on the same machine as `npm start`: TRUST_PROXY=127.0.0.1
# - Under compose.yaml, the proxy's connections reach the container from the
#   stack's network gateway, pinned in compose.yaml: TRUST_PROXY=10.203.0.1
#   (upgrading a stack from before that pin: `docker compose down` once first)
# The old value 1 is refused at startup.
# TRUST_PROXY=127.0.0.1

# --- Docker only (compose.yaml) ---------------------------------------------
# Password of the bundled Postgres. Letters and digits only: it is placed in
# connection URLs unescaped. compose.yaml sets NEON_DATABASE_URL and
# NEON_HTTP_ENDPOINT for the app itself — leave those two out of .env there.
# POSTGRES_PASSWORD=change_me_letters_and_digits
# Host port the app is published on (default 8888).
# PORT=8888

# Optional, server.mjs only: the interface it listens on, as an IP address (a
# hostname is refused at startup; tcsh exports HOST as one). Default 127.0.0.1;
# put a TLS reverse proxy in front rather than opening it to the network.
# The Docker image sets it to 0.0.0.0 inside the container itself.
# HOST=127.0.0.1
